---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import CtaSection from '@/components/CtaSection.astro';
import { industries } from '@/data/industries';
---
<Base title="תחומי התמחות — רואה חשבון לפי סוג עסק" description="רואה חשבון לעצמאים, לסטארטאפים, למסחר אלקטרוני, לנדל״ן ולעסקים משפחתיים. ליווי שמותאם לסוג העסק שלך.">
  <PageHero title="למי אנחנו" lead="כל סוג עסק מגיע עם שאלות מס משלו. אלה התחומים שבהם אנחנו עובדים כל יום." crumbs={[{ href: '/industries', label: 'למי אנחנו' }]} />
  <section class="section">
    <div class="wrap grid grid-2">
      {industries.map((i) => (
        <a class="card" href={`/industries/${i.slug}`}>
          <h2 style="font-size:1.375rem">{i.title}</h2>
          <p>{i.short}</p>
          <span class="more">לפרטים ←</span>
        </a>
      ))}
    </div>
  </section>
  <CtaSection formId="ind-form" />
</Base>
