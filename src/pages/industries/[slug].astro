---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceCards from '@/components/ServiceCards.astro';
import Testimonials from '@/components/Testimonials.astro';
import CtaSection from '@/components/CtaSection.astro';
import { industries, type Industry } from '@/data/industries';
import { services } from '@/data/services';

export function getStaticPaths() {
  return industries.map((i) => ({ params: { slug: i.slug }, props: { industry: i } }));
}
const { industry } = Astro.props as { industry: Industry };
const svc = services.filter((s) => industry.services.includes(s.slug));
---
<Base title={`רואה חשבון ל${industry.title}`} description={industry.metaDescription}>
  <PageHero title={`רואה חשבון ל${industry.title}`} lead={industry.intro} crumbs={[{ href: '/industries', label: 'למי אנחנו' }, { href: `/industries/${industry.slug}`, label: industry.title }]} />
  <section class="section">
    <div class="wrap grid grid-2">
      <div class="card">
        <h2 style="font-size:1.375rem">האתגרים שאנחנו פוגשים</h2>
        <ul>{industry.pains.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="card">
        <h2 style="font-size:1.375rem">איך אנחנו עוזרים</h2>
        <ul class="checklist">{industry.howWeHelp.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>
  <section class="section section--soft">
    <div class="wrap">
      <h2>השירותים הרלוונטיים</h2>
      <ServiceCards items={svc} />
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2>לקוחות מספרים</h2>
      <Testimonials industry={industry.slug} />
    </div>
  </section>
  <CtaSection formId="industry-form" />
</Base>
