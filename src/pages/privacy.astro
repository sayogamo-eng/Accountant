---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { business, fullAddress } from '@/data/business';
import { date } from '@/data/format';
const updated = business.accessibility.statementDate;
---
<Base title="מדיניות פרטיות ואבטחת מידע" description={`כיצד ${business.shortName} אוסף, שומר ומגן על המידע האישי והפיננסי שלך.`}>
  <PageHero title="מדיניות פרטיות ואבטחת מידע" crumbs={[{ href: '/privacy', label: 'מדיניות פרטיות' }]} />
  <section class="section">
    <div class="wrap prose">
      <p class="note"><strong>טיוטה לבדיקה משפטית.</strong> הנוסח מבוסס על המידע שהאתר אוסף בפועל, ויש לאשר אותו מול יועץ משפטי לפני העלייה לאוויר.</p>
      <p>עודכן לאחרונה: <time datetime={updated}>{date(updated)}</time></p>
      <h2>מי אנחנו</h2>
      <p>{business.legalName} (ח.פ. <span class="num">{business.businessId}</span>), {fullAddress}. מדיניות זו חלה על האתר ועל המידע שנמסר דרכו, ונכתבה בהתאם לחוק הגנת הפרטיות, התשמ״א-1981, ותקנותיו, לרבות תיקון 13.</p>
      <h2>איזה מידע נאסף</h2>
      <ul>
        <li><strong>טופס יצירת קשר:</strong> שם, טלפון, סוג העסק, נושא הפנייה ותוכן ההודעה — רק מה שנדרש כדי לחזור אליך.</li>
        <li><strong>מקור ההגעה:</strong> פרמטרי קמפיין (UTM) ועמוד השליחה, כדי לדעת איך הגעת אלינו.</li>
        <li><strong>עוגיות מדידה (Google Analytics):</strong> רק אם אישרת זאת בבאנר העוגיות.</li>
      </ul>
      <p>אין חובה חוקית למסור את המידע, אך בלעדיו לא נוכל לחזור אליך.</p>
      <h2>למה המידע משמש</h2>
      <p>לחזרה לפנייתך, לתיאום פגישה ולמתן השירות. אם סימנת הסכמה לקבלת עדכונים — גם לשליחת עדכוני מס. אפשר להסיר את ההסכמה בכל עת.</p>
      <h2>אבטחת מידע</h2>
      <ul>
        <li>האתר פועל בחיבור מוצפן (HTTPS) בלבד.</li>
        <li>מסמכים פיננסיים של לקוחות אינם נשלחים דרך טופס האתר, אלא דרך מערכת מאובטחת ייעודית.</li>
        <li>הגישה למידע מוגבלת לעובדי המשרד הזקוקים לו לצורך הטיפול, וכפופה לחובת סודיות מקצועית.</li>
      </ul>
      <h2>העברת מידע לצדדים שלישיים</h2>
      <p>המידע אינו נמכר. הוא מועבר רק לספקי שירות הפועלים עבורנו (אחסון, דיוור, מערכת ניהול פניות) ובמידה הנדרשת, או כשהדין מחייב זאת. עמוד צור הקשר מציג מפה של Google Maps.</p>
      <h2 id="cookies">עוגיות</h2>
      <p>האתר משתמש בעוגיות מדידה רק לאחר אישורך. אפשר לשנות את הבחירה בכל עת דרך "הגדרות עוגיות" בתחתית העמוד.</p>
      <h2>הזכויות שלך</h2>
      <p>אפשר לעיין במידע שנשמר עליך, לבקש לתקן או למחוק אותו, ולבקש הסרה מרשימת הדיוור. פניות: {business.privacy.officer}, <a href={`mailto:${business.privacy.email}`} class="num">{business.privacy.email}</a>.</p>
    </div>
  </section>
</Base>
