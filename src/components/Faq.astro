---
import JsonLd from './JsonLd.astro';
interface Props { items: { q: string; a: string }[]; schema?: boolean }
const { items, schema = false } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <div><p>{f.a}</p></div>
    </details>
  ))}
</div>
{schema && items.length > 0 && (
  <JsonLd data={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  }} />
)}
