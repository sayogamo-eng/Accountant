---
import { business, stats } from '@/data/business';
import Icon from './Icon.astro';
---
<section class="trust" aria-label="למה לסמוך עלינו">
  <div class="wrap">
    <ul class="stats">
      {stats.map((s) => <li><strong class="num">{s.value}</strong><span>{s.label}</span></li>)}
    </ul>
    <ul class="certs">
      {business.certifications.map((c) => <li><Icon name="check" size={20} />{c}</li>)}
    </ul>
    <p class="soft"><span>עובדים עם:</span> {business.software.map((s) => <span class="tag">{s}</span>)}</p>
  </div>
</section>
<style>
  .trust { border-block: 1px solid var(--line); background: #fff; padding-block: 1.75rem; }
  .stats { list-style: none; padding: 0; margin: 0 0 1.25rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; text-align: center; }
  .stats strong { display: block; font-size: clamp(1.5rem, 4vw, 2.25rem); color: var(--navy-900); line-height: 1.2; }
  .stats span { color: var(--muted); font-size: .9rem; }
  .certs { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem 1.5rem; font-weight: 500; }
  .certs li { display: inline-flex; gap: .4rem; align-items: center; }
  .certs :global(svg) { color: var(--teal-600); }
  .soft { display: flex; flex-wrap: wrap; gap: .4rem; justify-content: center; align-items: center; margin: 0; color: var(--muted); font-size: .9rem; }
</style>
