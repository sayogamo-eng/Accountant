---
import { telHref, whatsappHref } from '@/data/business';
import Icon from './Icon.astro';
---
<div class="mobile-bar">
  <a href={telHref} data-event="phone_click"><Icon name="phone" size={20} />התקשרו</a>
  <a href={whatsappHref()} data-event="whatsapp_click" rel="noopener" target="_blank"><Icon name="whatsapp" size={20} />WhatsApp</a>
  <a href="/contact" class="primary"><Icon name="calendar" size={20} />פגישת ייעוץ</a>
</div>
<style>
  .mobile-bar { position: fixed; inset-inline: 0; bottom: 0; z-index: 40; display: grid; grid-template-columns: repeat(3, 1fr); background: #fff; border-top: 1px solid var(--line); box-shadow: 0 -4px 16px rgb(13 33 55 / 8%); }
  .mobile-bar a { display: flex; flex-direction: column; align-items: center; gap: .1rem; padding: .5rem; min-height: 56px; font-size: .8125rem; font-weight: 700; color: var(--navy-900); text-decoration: none; }
  .mobile-bar a.primary { background: var(--teal-600); color: #fff; }
  @media (min-width: 720px) { .mobile-bar { display: none; } }
</style>
