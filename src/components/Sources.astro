---
import type { Source } from '@/data/tax';
import { date } from '@/data/format';
import { updatedAt } from '@/data/tax';
interface Props { sources: Source[] }
const { sources } = Astro.props;
---
<p class="sources" style="font-size:.875rem;color:var(--muted)">
  מקור: {sources.map((s, i) => <>{i > 0 && ' · '}<a href={s.url} rel="noopener" target="_blank">{s.label}</a></>)}
  {' '}| עודכן: <time datetime={updatedAt}>{date(updatedAt)}</time>
</p>
